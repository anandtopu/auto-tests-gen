# --- LLM ---
ANTHROPIC_API_KEY=
# --- Adapter mode (1 = mock adapters for demos, 0 = real adapters) ---
AIQE_MOCK=1
# --- SSL verification (set to 0 on corporate networks with a custom CA / self-signed certs) ---
# SSO via reverse proxy (OpenShift oauth-proxy, nginx+SSO): the header carrying
# the authenticated user. Set ONLY when a proxy in front terminates auth and
# strips/overwrites this header — it is trusted verbatim. Fails closed: with it
# set, requests without the header get 401. Approvals default to its value.
AIQE_SSO_HEADER=
AIQE_SSL_VERIFY=1
# --- HTTPS proxy (corporate networks that can't reach external HTTPS directly) ---
AIQE_HTTPS_PROXY=              # e.g. http://desktop.proxy.vzwcorp.com:5150
AIQE_NO_PROXY=                 # comma-separated hosts/domains that bypass the proxy, e.g. .verizon.com,localhost
# --- SCM (choose per estate; SCM_KIND=github|bitbucket|stash selects the adapter) ---
SCM_KIND=github
AIQE_STATUS_URL=              # URL the ai-qe PR build status links to (e.g. the dashboard)
GITHUB_TOKEN=                 # fine-grained: contents RW on feature branches only
BITBUCKET_TOKEN=              # Bitbucket Cloud app password / access token
STASH_URL=                    # Bitbucket Server/DC ("Stash") base URL, e.g. https://stash.company.com
STASH_PROJECT=                # project key, e.g. ENG
STASH_TOKEN=                  # HTTP access token (repo read + PR comment; RW for test repos)
# --- Atlassian Remote MCP (covers Jira + Confluence + Bitbucket) ---
JIRA_URL=                     # e.g. https://your-domain.atlassian.net (tracker REST fallback)
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp
ATLASSIAN_MCP_TOKEN=          # service account API token (headless)
CONFLUENCE_URL=               # e.g. https://your-domain.atlassian.net/wiki (publish-plan)
CONFLUENCE_SPACE=QA           # default space for test-plan mirroring
# --- LLM provider (which model runs the phases; empty = org-config default) ---
AIQE_LLM_PROVIDER=            # claude | ollama | codex | openhands (empty = org-config llm.provider)
OLLAMA_URL=                   # OpenAI-compatible /v1 (default http://localhost:11434/v1)
OLLAMA_API_KEY=               # optional; local daemons need none
CODEX_BIN=                    # default `codex` on PATH; absolute path if elsewhere
AIQE_OPENHANDS_PROVIDER=      # 1 = delegate phases to OpenHands (experimental, completion phases only)
OPENHANDS_PHASE_TIMEOUT=900   # seconds to wait on a delegated conversation
# --- Cost levers (each mechanism has its own kill switch) ---
AIQE_PHASE_CACHE=1            # content-addressed phase reuse (0 = off)
AIQE_CONTEXT_SCOPE=1          # retrieval-scoped context for org-config phases (0 = full AGENTS.md)
AIQE_CONTEXT_RETRY=1          # one full-estate retry when a scoped phase reports missing_context
AIQE_PLAN_REUSE=0             # semantic plan reuse (plan mode only; default off until the quality eval)
AIQE_TESTCASE_INDEX=0          # case-level JS/TS knowledge chunks (S1 preview; default off)
AIQE_TESTCASE_CHUNK_CHARS=2000 # maximum characters per physical testcase chunk
AIQE_ARTIFACT_STORE=0          # B1 durable content-addressed agent artifacts (default off)
AIQE_ARTIFACTS_DIR=            # optional store override; default reports/agent-artifacts
AIQE_ARTIFACT_KEEP_RUNS=200    # newest producing runs retained by make maintain
AIQE_ARTIFACT_MAX_BYTES=1048576 # per-artifact secret-scan/size ceiling
AIQE_IMPACT_ANALYSIS=0         # A3 deterministic-first impacted-case proposals (default off)
AIQE_IMPACT_DETERMINISTIC_THRESHOLD=0.70
AIQE_IMPACT_SEMANTIC_THRESHOLD=0.78  # embedding cosine distribution
AIQE_IMPACT_LEXICAL_THRESHOLD=0.30   # separate zero-embedding distribution
AIQE_ARTIFACT_REUSE=0         # A4 advisory near-duplicate warnings (never gates generation)
AIQE_TEST_REVIEWER=0          # B1 read-only post-validation review (advisory; default off)
AIQE_PR_TICKET_CONTEXT=0      # PR ticket discovery/provenance (default off)
AIQE_PR_PLAN=0                # S5 plan-first from a PR (opt-in; reuses plan_state)
AIQE_DUPLICATE_SEMANTIC_THRESHOLD=0.90
AIQE_DUPLICATE_LEXICAL_THRESHOLD=0.55 # separate zero-embedding distribution
# --- Embeddings (OPTIONAL semantic index; unset = lexical TF-IDF fallback) ---
EMBED_URL=                    # OpenAI-compatible /v1 base (Voyage/OpenAI/Azure/TEI/Ollama)
EMBED_API_KEY=                # bearer token for the embeddings endpoint
EMBED_MODEL=                  # e.g. voyage-3-lite / text-embedding-3-small
EMBED_DIMS=                   # optional; passed through when the provider supports it
# --- OpenHands (OPTIONAL orchestrator, Path 1; docs/integrations/standalone-operation.md) ---
# The pipeline never calls OpenHands — runs also trigger from CI, the TaskEvent
# receiver, or the work queue. This flag says how much you depend on it:
#   off       never contact it; the estate runs standalone
#   auto      hybrid (default): use it when reachable, fall back when not; an
#             outage is reported as `degraded` and never fails check-integrations
#   required  a hard dependency — an outage exits non-zero
AIQE_OPENHANDS=auto
OPENHANDS_URL=                # Agent Server base URL (enterprise/cloud)
OPENHANDS_API_KEY=
OPENHANDS_CONVERSATIONS_PATH= # /api/v1/app-conversations for Cloud; leave blank for self-hosted
AIQE_SANDBOX_IMAGE=ai-qe-sandbox:latest
AIQE_CONTROL_REPO=org/ai-qe-control
AIQE_SMOKE_TICKET=            # a real readable ticket for the smoke test (e.g. PROJ-123)
AIQE_SMOKE_REPO=              # a real repo with an open PR for the smoke test
AIQE_SMOKE_PR=

# --- CI/CD ---
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
# --- Notify / Telemetry ---
NOTIFY_KIND=slack             # slack | email | both — which channel(s) get run notifications
SLACK_WEBHOOK_URL=
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
# --- Email (SMTP) — run summaries, review digests, team reports ---
SMTP_HOST=                    # smtp.example.com (unset -> emails written to out/mock-email/)
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                    # ai-qe@example.com (defaults to SMTP_USER)
SMTP_TO=                      # default recipients, csv: qa-team@example.com,lead@example.com
# --- Budgets (ENFORCED: pipeline checks before every phase; over-limit runs
# abort with exit 77 + notification, before the gate. Cost = summed claude-phase
# spend; 0/unset falls back to org-config budgets. Wall-clock applies always.) ---
MAX_COST_USD_PER_RUN=4.00
MAX_WALLCLOCK_MIN=25

# --- Spec-driven governance (SDD adoption S3). Both OVERRIDE org-config
# `spec.*`; empty = use org-config. They live here because org-config.yaml ships
# inside the image and cannot be written under readOnlyRootFilesystem, so a
# deployed estate previously had no way to enable this at all.
# Roll out in two steps: warn until the signal is clean, then strict. ---
AIQE_REQUIREMENTS_GATE=        # 1 = plan/jira REFUSE (exit 65) until requirements approved
AIQE_SPEC_ENFORCE=             # off | warn | strict (strict = gate exit 8 on an uncovered scenario)
