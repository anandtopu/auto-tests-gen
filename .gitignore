.env
out/
reports/*.json
reports/*.log
__pycache__/
*.pyc
workspace/
reports/dashboard.html
reports/exports/
eval/results/
.idea/
.pytest_cache/
.coverage
htmlcov/
reports/coverage.xml
reports/inline/
reports/catalog.db
reports/knowledge-index/
reports/agent-artifacts/

# Work-queue state: items currently queued/running/failed. This is in-flight work,
# not a record of anything decided — it churns on every run and is wiped by
# `make clear-demo`. Contrast reports/runs/reviews.json, which IS tracked because
# team-review decisions and release assignments are durable data the scorecard reads.
reports/runs/queue.json

# Live OpenHands conversation view: bounded to the most recent conversations and
# pruned on a timer. Same class as the queue — in-flight state, not decisions.
reports/openhands/state.json
reports/coverage-drift.json

# Generated per-repo AGENTS.md (engine/lib/repo_guidance_gen.py) — derived from the
# registry, harvested surface and catalog, so it is rebuilt on demand rather than
# committed. bin/gen_agents_md.py regenerates any that are missing before it runs.
knowledge/generated/

# Properties config for external systems — holds API tokens, like .env.
# aiqe.properties.example is committed; the real file is not.
aiqe.properties
config/aiqe.properties

# VCP OpenShift secret manifest — contains real tokens, never commit.
# secret.example.yaml (placeholder) is committed; secret.yaml is not.
deploy/vcp/secret.yaml
reports/phase-cache/

# Derived per-repo facts (repo_facts.py rebuild) — authored facts ARE tracked
knowledge/facts/derived/

# Transaction log (observability slice 1) — runtime data, never committed.
# Rebuilt by running; retention is `observability.retain_days` via `make maintain`.
reports/events/
reports/events.db

# Run records and their archived diffs. Runtime data: written by every run,
# pruned to `make prune KEEP=200` nightly, and carried between deployments by the
# state bundle rather than by git. Neither tracked nor ignored before this, so
# ~690 files sat permanently in `git status`, hiding real changes.
#
# Matched by the record NAME SHAPE (<epoch>-<pid>), NOT by `reports/runs/*.json`.
# Three named state files share that directory — reviews.json (tracked),
# queue.json and hooks-seen.json — and CLAUDE.md already warns that every glob
# over it must skip them. A blanket pattern would also swallow the next state
# file somebody adds there, silently.
reports/runs/[0-9]*.json
reports/runs/[0-9]*.diff

# Durable spend ledger entries. Match generated run ids by name shape so a
# future named policy/state file under reports/costs remains visible to git.
reports/costs/[0-9]*.json

# Guidance fetched from other repositories (guidance_sync). A CACHE — re-pulled by
# `make sync-guidance`, and it holds files those repos own, not this one.
knowledge/synced/

# CI test health (test_health.ingest / `make ingest-results`). Runtime data of the
# same class as reports/coverage-drift.json above — rebuilt from CI results, and
# carried between deployments by the state bundle, not by git.
catalog/health.json

# Generated canonical test data. Deliberately untracked since e41d128 ("re-park
# estate"), which removed it; the state bundle carries it as work.
testdata/
