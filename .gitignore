.env
out/
reports/*.json
reports/*.log
__pycache__/
*.pyc
workspace/
reports/dashboard.html
reports/exports/
eval/results/
.idea/
.pytest_cache/
reports/inline/
reports/catalog.db
reports/knowledge-index/

# Work-queue state: items currently queued/running/failed. This is in-flight work,
# not a record of anything decided — it churns on every run and is wiped by
# `make clear-demo`. Contrast reports/runs/reviews.json, which IS tracked because
# team-review decisions and release assignments are durable data the scorecard reads.
reports/runs/queue.json

# Live OpenHands conversation view: bounded to the most recent conversations and
# pruned on a timer. Same class as the queue — in-flight state, not decisions.
reports/openhands/state.json
reports/coverage-drift.json

# Generated per-repo AGENTS.md (engine/lib/repo_guidance_gen.py) — derived from the
# registry, harvested surface and catalog, so it is rebuilt on demand rather than
# committed. bin/gen_agents_md.py regenerates any that are missing before it runs.
knowledge/generated/

# Properties config for external systems — holds API tokens, like .env.
# aiqe.properties.example is committed; the real file is not.
aiqe.properties
config/aiqe.properties

# VCP OpenShift secret manifest — contains real tokens, never commit.
# secret.example.yaml (placeholder) is committed; secret.yaml is not.
deploy/vcp/secret.yaml
reports/phase-cache/

# Derived per-repo facts (repo_facts.py rebuild) — authored facts ARE tracked
knowledge/facts/derived/
